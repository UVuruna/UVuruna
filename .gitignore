# Ignore everything in this monorepo root by default.
# Only the documentation files, rulebooks and logos are tracked on GitHub.
# Each project has its own git repository.

*

# Root documentation
!CLAUDE.md
!README.md
!PROJECTS.md
!DESIGN.md
!MIGRATE-DOCS.md
!REFACTOR-GODFILES.md
!MIGRATE-GUI.md
!MIGRATE-LAYOUT.md
!company.json
!.gitignore

# Rulebooks per job type
!rules/
!rules/**

# ...but never Python's build droppings: the guards and templates under
# rules/ are imported and run, and their caches were reaching GitHub.
rules/**/__pycache__/
rules/**/*.pyc

# PRIVATE.md is intentionally NOT whitelisted — hidden projects index stays local

# Project logos (SVG files used in README and PROJECTS)
!logos/
!logos/**
